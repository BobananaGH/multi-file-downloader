/* ── Global Styles ───────────────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #1e1e28;
    color: #e2e2e8;
    font-family: "Segoe UI", "Outfit", "Inter", sans-serif;
    font-size: 14px;
}

/* ── Header ───────────────────────────────────────────────────────────── */
QWidget#header {
    background-color: #14141d;
    border-bottom: 2px solid #2d2d3f;
}

QLabel#appTitle {
    font-size: 22px;
    font-weight: bold;
    color: #00d2ff;
    letter-spacing: 1px;
}

QLabel#appSubtitle {
    font-size: 12px;
    color: #78788c;
}

/* ── Live Status Bulb & Indicators ───────────────────────────────────── */
QLabel#statusLabel {
    font-size: 15px;
    font-weight: bold;
    color: #a0a0b0;
    padding-left: 6px;
}

QLabel#statusBulbRunning {
    background-color: #00e676;
    border-radius: 7px;
    border: 2px solid #14141d;
}

QLabel#statusBulbStopped {
    background-color: #ff1744;
    border-radius: 7px;
    border: 2px solid #14141d;
}

/* ── Divider ──────────────────────────────────────────────────────────── */
QFrame#divider {
    border: none;
    border-top: 1px solid #2d2d3f;
    max-height: 1px;
}

/* ── Tabs Styling ─────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #2d2d3f;
    background-color: #1e1e28;
    top: -1px;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #14141d;
    border: 1px solid #2d2d3f;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    color: #78788c;
}

QTabBar::tab:hover {
    background-color: #252535;
    color: #00d2ff;
}

QTabBar::tab:selected {
    background-color: #1e1e28;
    border-color: #2d2d3f;
    border-bottom: 1px solid #1e1e28;
    color: #ffffff;
}

/* ── Metric Cards ─────────────────────────────────────────────────────── */
QFrame#metricCard {
    background-color: #252535;
    border: 1px solid #323246;
    border-radius: 10px;
}

QLabel#cardHeader {
    font-size: 11px;
    font-weight: bold;
    color: #78788c;
    letter-spacing: 1.5px;
    border-bottom: 1px solid #323246;
    padding-bottom: 6px;
    margin-bottom: 6px;
}

QLabel#metricLabel {
    font-size: 13px;
    color: #a0a0b0;
}

QLabel#metricValue {
    font-size: 16px;
    font-weight: bold;
    color: #00e5ff;
}

/* ── Log Console ──────────────────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.5px;
    color: #78788c;
}

QTextEdit#consoleLog {
    background-color: #0f0f16;
    border: 1px solid #2d2d3f;
    border-radius: 10px;
    padding: 12px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    line-height: 1.4;
}

/* ── Tables Styling ───────────────────────────────────────────────────── */
QTableWidget#statsTable {
    background-color: #252535;
    border: 1px solid #2d2d3f;
    gridline-color: #323246;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QTableWidget#statsTable::item {
    padding: 8px;
    color: #e2e2e8;
}

QTableWidget#statsTable::item:hover {
    background-color: #323246;
}

QTableWidget#statsTable::item:selected {
    background-color: #29b6f6;
    color: #000000;
}

QHeaderView::section {
    background-color: #14141d;
    color: #78788c;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 6px;
    border: none;
    border-bottom: 2px solid #2d2d3f;
}

/* ── Buttons ──────────────────────────────────────────────────────────── */
QPushButton {
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#startBtn {
    background-color: #00c853;
    color: #ffffff;
    border: none;
}

QPushButton#startBtn:hover {
    background-color: #00e676;
}

QPushButton#startBtn:pressed {
    background-color: #00b0ff;
}

QPushButton#stopBtn {
    background-color: #d50000;
    color: #ffffff;
    border: none;
}

QPushButton#stopBtn:hover {
    background-color: #ff1744;
}

QPushButton#stopBtn:pressed {
    background-color: #b70000;
}

QPushButton#stopBtn:disabled {
    background-color: #323246;
    color: #5a5a6e;
}

QPushButton#kickBtn {
    background-color: #ff3d00;
    color: #ffffff;
    border: none;
}

QPushButton#kickBtn:hover {
    background-color: #ff6d00;
}

QPushButton#kickBtn:disabled {
    background-color: #323246;
    color: #5a5a6e;
}

QPushButton#clearBtn {
    background-color: transparent;
    border: 1px solid #5a5a6e;
    color: #a0a0b0;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: normal;
}

QPushButton#clearBtn:hover {
    border-color: #e57373;
    color: #e57373;
    background-color: #2d1c1c;
}

/* ── Scrollbars ───────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #14141d;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3e3e56;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #00d2ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}