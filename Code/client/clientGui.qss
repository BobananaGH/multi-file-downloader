/* ══════════════════════════════════════════════════════════════
   FLUX — Purple/Blue Gradient Theme
   ══════════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #0f0f1a;
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* ── Header ─────────────────────────────────────────────────── */
QWidget#header {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1a0533,
        stop: 0.5 #1e1245,
        stop: 1 #0d1f4a
    );
    border-bottom: 1px solid #5a3f8a;
}

QLabel#appTitle {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    padding-right: 8px;
}

QLabel#appSubtitle {
    font-size: 13px;
    color: #b0a0cc;
    padding-top: 4px;
}

/* ── Dividers ───────────────────────────────────────────────── */
QFrame#divider {
    border: none;
    border-top: 1px solid #2a2a3a;
    max-height: 1px;
}

/* ── Body panel ─────────────────────────────────────────────── */
QWidget#body {
    background-color: #0f0f1a;
}

/* ── Section labels ─────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

QLabel#countLabel {
    font-size: 12px;
    font-weight: bold;
    color: #ffffff;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #5a2d9e,
        stop: 1 #3a5fd4
    );
    border-radius: 10px;
    padding: 3px 12px;
}

/* ── Search bar ─────────────────────────────────────────────── */
QLabel#searchIcon {
    font-size: 16px;
    color: #8888cc;
    padding-right: 4px;
}

QLineEdit#searchBar {
    background-color: #1a1a2e;
    border: 1.5px solid #3a3a5a;
    border-radius: 20px;
    color: #ffffff;
    padding: 10px 18px;
    font-size: 14px;
    font-family: "Segoe UI";
    selection-background-color: #7c3aed;
    selection-color: #ffffff;
}

QLineEdit#searchBar:focus {
    border: 1.5px solid #7c3aed;
    background-color: #1e1e35;
}

/* ── File list (TreeWidget) ─────────────────────────────────── */
QTreeWidget#fileList {
    background-color: #13132a;
    border: 1.5px solid #2a2a4a;
    border-radius: 12px;
    padding: 6px;
    outline: none;
    font-size: 14px;
    font-family: "Segoe UI";
}

QTreeWidget#fileList::item {
    padding: 10px 8px;
    border-radius: 8px;
    color: #e0e0ff;
    margin: 1px 0px;
}

QTreeWidget#fileList::item:hover {
    background-color: #1e1e3a;
}

QTreeWidget#fileList::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #3d1f7a,
        stop: 1 #1f3d7a
    );
    color: #ffffff;
}

QTreeWidget#fileList::item:selected:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #4a2a8a,
        stop: 1 #2a4a8a
    );
}

QHeaderView::section {
    background-color: #0f0f1a;
    color: #7070aa;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #2a2a4a;
}

QHeaderView::section:hover {
    color: #aa88ff;
}

/* ── Scrollbars ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #13132a;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #3a3a6a;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #7c3aed;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── Refresh button ─────────────────────────────────────────── */
QPushButton#refreshBtn {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #5a2d9e,
        stop: 1 #3a5fd4
    );
    border: none;
    border-radius: 10px;
    color: #ffffff;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#refreshBtn:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #6a3dae,
        stop: 1 #4a6fe4
    );
}

QPushButton#refreshBtn:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #4a1d8e,
        stop: 1 #2a4fc4
    );
}

QPushButton#refreshBtn:disabled {
    background: #2a2a3a;
    color: #555577;
}

/* ── Download button ────────────────────────────────────────── */
QPushButton#downloadBtn {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #4a6fe4,
        stop: 1 #7c3aed
    );
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 14px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#downloadBtn:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #5a7ff4,
        stop: 1 #8c4afd
    );
}

QPushButton#downloadBtn:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #3a5fd4,
        stop: 1 #6c2add
    );
}

QPushButton#downloadBtn:disabled {
    background: #2a2a3a;
    color: #555577;
}

/* ── Clear button ───────────────────────────────────────────── */
QPushButton#clearBtn {
    background-color: #2a1a2a;
    border: 1.5px solid #6a2a2a;
    border-radius: 8px;
    color: #cc6666;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#clearBtn:hover {
    background-color: #3a1a1a;
    border-color: #e25555;
    color: #ff7777;
}

/* ── Downloads panel ────────────────────────────────────────── */
QWidget#downloadsPanel {
    background-color: #0f0f1a;
    border-top: 1px solid #2a2a4a;
}

QScrollArea#downloadScroll {
    background-color: transparent;
    border: 1.5px solid #2a2a4a;
    border-radius: 12px;
}

/* ── Download item card ─────────────────────────────────────── */
QFrame#downloadItem {
    background-color: #13132a;
    border: 1px solid #2a2a4a;
    border-radius: 10px;
    margin: 0px 2px;
}

QFrame#downloadItem:hover {
    border-color: #5a3f8a;
}

QLabel#downloadFilename {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    font-family: "Segoe UI";
}

QLabel#downloadStatus {
    font-size: 12px;
    font-weight: bold;
    color: #7070aa;
    min-width: 70px;
    padding: 3px 8px;
    border-radius: 6px;
}

QLabel#downloadStatus[state="active"] {
    color: #6699ff;
    background-color: #1a2040;
}

QLabel#downloadStatus[state="done"] {
    color: #55cc88;
    background-color: #0a2a1a;
}

QLabel#downloadStatus[state="error"] {
    color: #ff5555;
    background-color: #2a0a0a;
}

QLabel#downloadStatus[state="cancelled"] {
    color: #888888;
    background-color: #1a1a1a;
}

QLabel#downloadInfo {
    font-size: 11px;
    color: #5566aa;
    font-family: "Segoe UI";
}

QProgressBar#downloadProgress {
    background-color: #1a1a35;
    border: none;
    border-radius: 4px;
    height: 6px;
}

QProgressBar#downloadProgress::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #4a6fe4,
        stop: 1 #7c3aed
    );
    border-radius: 4px;
}

/* ── Cancel button ──────────────────────────────────────────── */
QPushButton#cancelBtn {
    background-color: transparent;
    border: 1px solid #3a3a5a;
    border-radius: 4px;
    color: #7070aa;
    font-size: 10px;
    padding: 0px;
    font-weight: normal;
}

QPushButton#cancelBtn:hover {
    border-color: #e25555;
    color: #e25555;
    background-color: #2a0a0a;
}

/* ── Status bar ─────────────────────────────────────────────── */
QStatusBar#mainStatusBar {
    background-color: #0a0a15;
    color: #5566aa;
    border-top: 1px solid #1a1a3a;
    font-size: 12px;
    font-family: "Segoe UI";
    padding: 2px 12px;
}

QStatusBar#mainStatusBar::item {
    border: none;
}

/* ── Context Menu ───────────────────────────────────────────── */
QMenu {
    background-color: #13132a;
    border: 1px solid #3a3a6a;
    border-radius: 10px;
    padding: 6px;
    color: #ffffff;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 6px;
    background-color: transparent;
    margin: 2px 0px;
}

QMenu::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #5a2d9e,
        stop: 1 #3a5fd4
    );
    color: #ffffff;
}

QMenu::item:disabled {
    color: #444466;
}

QMenu::separator {
    height: 1px;
    background: #2a2a4a;
    margin: 6px 4px;
}

/* ── Scrollbar in download panel ────────────────────────────── */
QScrollArea#downloadScroll QScrollBar:vertical {
    background: #0f0f1a;
    width: 6px;
}

QScrollArea#downloadScroll QScrollBar::handle:vertical {
    background: #3a3a6a;
    border-radius: 3px;
}

QScrollArea#downloadScroll QScrollBar::handle:vertical:hover {
    background: #7c3aed;
}
