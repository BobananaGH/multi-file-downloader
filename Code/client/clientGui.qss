/* ── Global ───────────────────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* ── Header ───────────────────────────────────────────────────────────── */
QWidget#header {
    background-color: #1e1e1e;
    border-bottom: 2px solid #4a90e2;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: bold;
    color: #4a90e2;
    padding-right: 8px;
}

QLabel#appSubtitle {
    font-size: 12px;
    color: #888888;
    padding-top: 3px;
}

/* ── Dividers ─────────────────────────────────────────────────────────── */
QFrame#divider {
    border: none;
    border-top: 1px solid #444444;
    max-height: 1px;
}

/* ── Body panel ───────────────────────────────────────────────────────── */
QWidget#body {
    background-color: #2b2b2b;
}

/* ── Section labels ───────────────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 11px;
    letter-spacing: 2px;
    color: #888888;
    font-weight: bold;
}

QLabel#countLabel {
    font-size: 12px;
    color: #4a90e2;
}

/* ── Search bar ───────────────────────────────────────────────────────── */
QLabel#searchIcon {
    font-size: 14px;
    color: #888888;
    padding-right: 4px;
}

QLineEdit#searchBar {
    background-color: #3a3a3a;
    border: 2px solid #555555;
    border-radius: 8px;
    color: #ffffff;
    padding: 8px 12px;
    font-size: 14px;
    font-family: "Segoe UI";
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
}

QLineEdit#searchBar:focus {
    border: 2px solid #4a90e2;
    background-color: #404040;
}

/* ── File list (TreeWidget) ───────────────────────────────────────────── */
QTreeWidget#fileList {
    background-color: #3a3a3a;
    border: 2px solid #555555;
    border-radius: 8px;
    padding: 6px;
    outline: none;
    font-size: 14px;
    font-family: "Segoe UI";
}

QTreeWidget#fileList::item {
    padding: 6px;
    border-radius: 4px;
    color: #ffffff;
}

QTreeWidget#fileList::item:hover {
    background-color: #505050;
}

QTreeWidget#fileList::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QTreeWidget#fileList::item:selected:hover {
    background-color: #357abd;
}

QHeaderView::section {
    background-color: #2b2b2b;
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #444444;
}

QHeaderView::section:hover {
    background-color: #333333;
    color: #4a90e2;
}

/* ── Scrollbars ───────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #3a3a3a;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #666666;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #4a90e2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── Buttons ──────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #4a90e2;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    font-family: "Segoe UI";
    font-size: 14px;
}

QPushButton:hover {
    background-color: #357abd;
}

QPushButton:pressed {
    background-color: #2d5f94;
}

QPushButton:disabled {
    background-color: #666666;
    color: #aaaaaa;
}

/* ── Refresh button ───────────────────────────────────────────────────── */
QPushButton#refreshBtn {
    background-color: transparent;
    border: 2px solid #4a90e2;
    border-radius: 8px;
    color: #4a90e2;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#refreshBtn:hover {
    background-color: #4a90e2;
    color: #ffffff;
}

QPushButton#refreshBtn:pressed {
    background-color: #2d5f94;
    color: #ffffff;
}

QPushButton#refreshBtn:disabled {
    border-color: #666666;
    color: #666666;
    background-color: transparent;
}

/* ── Download button ──────────────────────────────────────────────────── */
QPushButton#downloadBtn {
    background-color: #4a90e2;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#downloadBtn:hover {
    background-color: #357abd;
}

QPushButton#downloadBtn:pressed {
    background-color: #2d5f94;
}

/* ── Clear button ─────────────────────────────────────────────────────── */
QPushButton#clearBtn {
    background-color: transparent;
    border: 1px solid #555555;
    border-radius: 6px;
    color: #888888;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: normal;
}

QPushButton#clearBtn:hover {
    border-color: #e25555;
    color: #e25555;
    background-color: #3a2020;
}

/* ── Downloads panel ──────────────────────────────────────────────────── */
QWidget#downloadsPanel {
    background-color: #242424;
    border-top: 1px solid #444444;
}

QScrollArea#downloadScroll {
    background-color: transparent;
    border: 2px solid #555555;
    border-radius: 8px;
}

QWidget#downloadsContainer {
    background-color: #2b2b2b;
}

/* ── Download item card ───────────────────────────────────────────────── */
QFrame#downloadItem {
    background-color: #3a3a3a;
    border: 1px solid #555555;
    border-radius: 8px;
    margin: 0px 4px;
}

QFrame#downloadItem:hover {
    border-color: #4a90e2;
}

QLabel#downloadFilename {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    font-family: "Segoe UI";
}

QLabel#downloadStatus {
    font-size: 12px;
    color: #888888;
    min-width: 60px;
}

QLabel#downloadStatus[state="active"] {
    color: #4a90e2;
}

QLabel#downloadStatus[state="done"] {
    color: #5cb85c;
}

QLabel#downloadStatus[state="error"] {
    color: #e25555;
}

QLabel#downloadInfo {
    font-size: 11px;
    color: #666666;
    font-family: "Segoe UI";
}

QProgressBar#downloadProgress {
    background-color: #555555;
    border: none;
    border-radius: 3px;
    height: 6px;
}

QProgressBar#downloadProgress::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #357abd,
        stop: 1 #4a90e2
    );
    border-radius: 3px;
}

/* ── Status bar ───────────────────────────────────────────────────────── */
QStatusBar#mainStatusBar {
    background-color: #1e1e1e;
    color: #888888;
    border-top: 1px solid #444444;
    font-size: 12px;
    font-family: "Segoe UI";
    padding: 2px 12px;
}

QStatusBar#mainStatusBar::item {
    border: none;
}

/* ── Scrollbar in download panel ──────────────────────────────────────── */
QScrollArea#downloadScroll QScrollBar:vertical {
    background: #2b2b2b;
    width: 6px;
}

QScrollArea#downloadScroll QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 3px;
}

QScrollArea#downloadScroll QScrollBar::handle:vertical:hover {
    background: #4a90e2;
}

QPushButton#cancelBtn {
    background-color: transparent;
    border: 1px solid #555555;
    border-radius: 4px;
    color: #888888;
    font-size: 10px;
    padding: 0px;
    font-weight: normal;
}

QPushButton#cancelBtn:hover {
    border-color: #e25555;
    color: #e25555;
    background-color: #3a2020;
}
/* ── Context Menu ─────────────────────────────────────────────────────── */
QMenu {
    background-color: #2f2f2f;
    border: 1px solid #555555;
    border-radius: 8px;
    padding: 6px;
    color: #ffffff;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 6px;
    background-color: transparent;
    margin: 2px 0px;
}

QMenu::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #777777;
}

QMenu::separator {
    height: 1px;
    background: #444444;
    margin: 6px 4px;
}
